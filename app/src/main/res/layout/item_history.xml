<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Card"
    android:layout_marginBottom="8dp"
    app:contentPaddingBottom="8dp"
    app:contentPaddingTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/history_item_title"
                style="@style/Body" />

            <TextView
                android:id="@+id/history_item_time"
                style="@style/Hint" />
        </LinearLayout>

        <Button
            android:id="@+id/history_item_undo"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_undo" />

        <TextView
            android:id="@+id/history_item_done"
            style="@style/Badge"
            android:backgroundTint="@color/badge_neutral_bg"
            android:text="@string/history_undone"
            android:textColor="@color/badge_neutral_fg"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
